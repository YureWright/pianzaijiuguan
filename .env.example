# Server
PORT=3000
HOST=127.0.0.1

# Used only when data/config.json is created for the first time.
# Change it later from the admin console.
ADMIN_PASSWORD=change-this-admin-password

# Used only when data/accounts.json is created for the first time.
SHANGHAI_LOGIN_KEY=shanghai-login-key
HANGZHOU_LOGIN_KEY=hangzhou-login-key

# Runtime configuration and administrator-managed AI roles.
DATA_DIR=./data

# WebRTC ICE servers. Add a TURN server for cross-NAT internet play.
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# AI roles, model endpoints, API keys and avatars are configured in /admin.html.
